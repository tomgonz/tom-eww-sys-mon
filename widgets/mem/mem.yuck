;; =============================================
;; widgets/mem.yuck
;; =============================================

(defwidget mem []
   (box :class "mem-widget" :halign "center" :width widget_width
      (box :orientation "v" :space-evenly false :halign "center" :width graph_width

         (label :class "mem-title-text" :halign "start" :text "Memory ${formatbytes(EWW_RAM.total_mem,true,"iec")} / Swap ${formatbytes(EWW_RAM.total_swap,true,"iec")}")

         (box :class "mem-graph" :halign "center" :width graph_width :height graph_height_cpu_mem
            (graph
               :value {EWW_RAM.used_mem_perc}
               :time-range {graph_width + "s"}
               :thickness 1.0
               :line-style "round"
               :tooltip "${floor(EWW_RAM.used_mem_perc)}%"
            )
         )
         (label :class "mem-text" :halign "start" :text "Mem used: ${formatbytes(round(EWW_RAM.used_mem,0),true,'iec')}")

         (progress :class "swap-bar"
            :width graph_width
            :value {(EWW_RAM.total_swap - EWW_RAM.free_swap) / EWW_RAM.total_swap * 100}
            :tooltip "${floor((EWW_RAM.total_swap - EWW_RAM.free_swap) / EWW_RAM.total_swap * 100)}%"
         )

         (label :class "swap-text" :halign "start" :text "Swap used: ${formatbytes(EWW_RAM.total_swap - EWW_RAM.free_swap,true,"iec")}")

      )
   )
)   
